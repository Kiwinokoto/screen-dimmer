#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/screen-dimmer"
STATE_FILE="$STATE_DIR/value"

MIN="0.10"
MAX="1.00"
STEP="0.05"
DEFAULT="0.55"

mkdir -p "$STATE_DIR"

fail() {
  echo "Erreur: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "commande manquante: $1"
}

get_outputs() {
  xrandr --query | awk '/ connected/{print $1}'
}

clamp() {
  awk -v v="$1" -v min="$MIN" -v max="$MAX" '
    BEGIN {
      if (v < min) v = min;
      if (v > max) v = max;
      printf "%.2f", v;
    }
  '
}

read_value() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "$DEFAULT"
  fi
}

apply_value() {
  local value="$1"
  local outputs

  value="$(clamp "$value")"
  outputs="$(get_outputs)"

  [[ -n "$outputs" ]] || fail "aucun écran connecté trouvé par xrandr"

  while read -r output; do
    [[ -n "$output" ]] || continue
    xrandr --output "$output" --brightness "$value"
  done <<< "$outputs"

  echo "$value" > "$STATE_FILE"
  echo "Luminosité logicielle: $value"
}

adjust_value() {
  local direction="$1"
  local current
  local next

  current="$(read_value)"

  if [[ "$direction" == "up" ]]; then
    next="$(awk -v v="$current" -v step="$STEP" 'BEGIN { printf "%.2f", v + step }')"
  else
    next="$(awk -v v="$current" -v step="$STEP" 'BEGIN { printf "%.2f", v - step }')"
  fi

  apply_value "$next"
}

open_ui() {
  need_cmd zenity

  local current percent chosen value
  current="$(read_value)"
  percent="$(awk -v v="$current" 'BEGIN { printf "%d", v * 100 }')"

  local rc=0
  chosen="$(
    zenity --scale \
      --title="Screen dimmer" \
      --text="Luminosité logicielle" \
      --min-value=10 \
      --max-value=100 \
      --value="$percent" \
      --step=5 \
      --ok-label="Appliquer" \
      --cancel-label="Annuler" \
      --extra-button="Reset"
  )" || rc=$?

  [[ "$rc" -eq 0 ]] || return 0

  if [[ "$chosen" == "Reset" ]]; then
    apply_value "1.00"
    return 0
  fi

  value="$(awk -v p="$chosen" 'BEGIN { printf "%.2f", p / 100 }')"
  apply_value "$value"
}

need_cmd xrandr

case "${1:-ui}" in
  ui)
    open_ui
    ;;
  up)
    adjust_value up
    ;;
  down)
    adjust_value down
    ;;
  reset|off)
    apply_value "1.00"
    ;;
  *)
    apply_value "$1"
    ;;
esac
