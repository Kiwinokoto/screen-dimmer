#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/screen-dimmer"
STATE_FILE="$STATE_DIR/value"
MODE_FILE="$STATE_DIR/mode"

MIN="0.10"
MAX="1.00"
STEP="0.05"
DEFAULT_DIM="0.55"
SYSTEM_DEFAULT="1.00"

mkdir -p "$STATE_DIR"

fail() {
  echo "Erreur: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "commande manquante: $1"
}

get_outputs() {
  xrandr --query | awk '/ connected/{print $1}'
}

clamp() {
  awk -v v="$1" -v min="$MIN" -v max="$MAX" '
    BEGIN {
      if (v < min) v = min;
      if (v > max) v = max;
      printf "%.2f", v;
    }
  '
}

read_value() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "$DEFAULT_DIM"
  fi
}

read_mode() {
  local saved current

  if [[ -f "$MODE_FILE" ]]; then
    saved="$(cat "$MODE_FILE")"
    if [[ "$saved" == "normal" || "$saved" == "dimmed" ]]; then
      echo "$saved"
      return 0
    fi
  fi

  current="$(xrandr --verbose 2>/dev/null | awk '/Brightness:/ {print $2; exit}')" || true
  if [[ -n "$current" ]] && awk -v v="$current" 'BEGIN { exit !(v < 0.99) }'; then
    echo "dimmed"
  else
    echo "normal"
  fi
}

write_mode() {
  printf '%s\n' "$1" > "$MODE_FILE"
}

set_outputs_value() {
  local value="$1"
  local outputs output

  value="$(clamp "$value")"
  outputs="$(get_outputs)" || return 1
  [[ -n "$outputs" ]] || return 1

  while read -r output; do
    [[ -n "$output" ]] || continue
    xrandr --output "$output" --brightness "$value" || return 1
  done <<< "$outputs"

  printf '%s\n' "$value"
}

apply_dim_value() {
  local value

  value="$(set_outputs_value "$1")" ||
    fail "impossible d'appliquer la luminosité via xrandr"

  printf '%s\n' "$value" > "$STATE_FILE"
  write_mode "dimmed"
  echo "Luminosité logicielle atténuée: $value"
}

apply_normal() {
  set_outputs_value "$SYSTEM_DEFAULT" >/dev/null ||
    fail "impossible de restaurer la luminosité logicielle normale"

  write_mode "normal"
  echo "Luminosité logicielle normale: $SYSTEM_DEFAULT"
}

apply_saved_dim() {
  apply_dim_value "$(read_value)"
}

toggle_value() {
  if [[ "$(read_mode)" == "dimmed" ]]; then
    apply_normal
  else
    apply_saved_dim
  fi
}

adjust_value() {
  local direction="$1"
  local current next

  current="$(read_value)"

  if [[ "$direction" == "up" ]]; then
    next="$(awk -v v="$current" -v step="$STEP" 'BEGIN { printf "%.2f", v + step }')"
  else
    next="$(awk -v v="$current" -v step="$STEP" 'BEGIN { printf "%.2f", v - step }')"
  fi

  apply_dim_value "$next"
}

startup_safety_reset() {
  local attempt

  for ((attempt = 0; attempt < 5; attempt++)); do
    if set_outputs_value "$SYSTEM_DEFAULT" >/dev/null 2>&1; then
      write_mode "normal"
      return 0
    fi
    sleep 1
  done

  return 0
}

open_ui() {
  need_cmd zenity

  local current percent

  current="$(read_value)"
  apply_dim_value "$current" >/dev/null
  percent="$(awk -v v="$current" 'BEGIN { printf "%d", v * 100 }')"

  zenity --scale \
    --title="Screen Dimmer" \
    --text="Valeur du mode atténué — réglage en direct" \
    --min-value=10 \
    --max-value=100 \
    --value="$percent" \
    --step=5 \
    --print-partial \
    --ok-label="Fermer" \
    --no-cancel 2>/dev/null |
  while IFS= read -r event; do
    local value

    [[ "$event" =~ ^[0-9]+$ ]] || continue
    value="$(awk -v p="$event" 'BEGIN { printf "%.2f", p / 100 }')"
    apply_dim_value "$value" >/dev/null
  done || true
}

need_cmd xrandr

case "${1:-toggle}" in
  toggle)
    toggle_value
    ;;
  ui|adjust)
    open_ui
    ;;
  dim|on)
    apply_saved_dim
    ;;
  normal|reset|off)
    apply_normal
    ;;
  up)
    adjust_value up
    ;;
  down)
    adjust_value down
    ;;
  startup-reset)
    startup_safety_reset
    ;;
  *)
    apply_dim_value "$1"
    ;;
esac
